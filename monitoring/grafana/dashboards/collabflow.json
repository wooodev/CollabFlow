{
  "title": "CollabFlow — Spring Boot Overview",
  "uid": "collabflow-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"collabflow\"}[1m])) by (uri, status)",
        "legendFormat": "{{status}} {{uri}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "title": "HTTP Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"collabflow\",status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"collabflow\"}[1m])) * 100",
        "legendFormat": "Error Rate"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": {
        "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "red" }]
      }}}
    },
    {
      "id": 3,
      "title": "JVM Heap Memory",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "jvm_memory_used_bytes{job=\"collabflow\",area=\"heap\"}",
          "legendFormat": "Used"
        },
        {
          "datasource": "Prometheus",
          "expr": "jvm_memory_max_bytes{job=\"collabflow\",area=\"heap\"}",
          "legendFormat": "Max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 4,
      "title": "DB Connection Pool",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_active{job=\"collabflow\"}",
          "legendFormat": "Active"
        },
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_pending{job=\"collabflow\"}",
          "legendFormat": "Pending"
        },
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_max{job=\"collabflow\"}",
          "legendFormat": "Max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "title": "HTTP P99 Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"collabflow\"}[1m])) by (le, uri)) * 1000",
        "legendFormat": "p99 {{uri}}"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ]
}
